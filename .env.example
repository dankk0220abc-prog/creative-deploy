# Explicit trusted local-development configuration only. Never use these values in production.
# APP_ENV has no code default. The Demo Principal Adapter rejects production.
APP_ENV=development
APP_NAME=CreativeDeploy API
APP_VERSION=0.1.0
DATABASE_HEALTH_TIMEOUT_SECONDS=2.0
# Positive transaction-local PostgreSQL wait limits, each bounded to at most 60000 ms.
DATABASE_LOCK_TIMEOUT_MS=2000
DATABASE_STATEMENT_TIMEOUT_MS=5000
# Both non-secret Demo Principal fields are required for development and test startup.
IDENTITY_PROVIDER=configured_demo
PAINTPILOT_DEMO_PRINCIPAL_ID=local-demo-owner
PAINTPILOT_DEMO_PRINCIPAL_DISPLAY_NAME=Local Demo Owner
# Phase 1E-1 development/test adapter only. It is private and rejected in production.
IMAGE_STORAGE_PROVIDER=local_filesystem
IMAGE_STORAGE_ROOT=.local/private-image-storage
# For governed OIDC development, select IDENTITY_PROVIDER=oidc and configure all
# OIDC_* values. Never commit a real client secret. The project-owned provider
# in creativedeploy_api.local_oidc accepts synthetic users in development/test only.
# OIDC_ISSUER=http://127.0.0.1:8090
# OIDC_CLIENT_ID=paintpilot-local
# OIDC_CLIENT_SECRET=replace-with-a-local-secret
# OIDC_REDIRECT_URI=http://127.0.0.1:5173/api/v1/auth/callback
# OIDC_ID_TOKEN_MAX_AGE_SECONDS=300
# OIDC_CLOCK_SKEW_SECONDS=30
# For private S3/MinIO development, select IMAGE_STORAGE_PROVIDER=s3 and configure
# S3_ENDPOINT_URL, S3_REGION, S3_BUCKET, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY,
# and a private bucket. S3_ALLOW_INSECURE_HTTP/S3_CREATE_BUCKET are local-only.
# Frozen Image Upload Contract plus the Phase 1E-1 deterministic pixel safety ceiling.
IMAGE_UPLOAD_MAX_BYTES=20971520
IMAGE_MIN_SIDE_PX=768
IMAGE_MAX_SIDE_PX=8192
IMAGE_MAX_PIXELS=40000000
# Local development has one database source of truth: these POSTGRES_* values.
# Settings derives DATABASE_URL from the complete set and rejects a conflicting
# DATABASE_URL. Production instead injects an explicit DATABASE_URL.
POSTGRES_HOST=127.0.0.1
POSTGRES_USER=creativedeploy
POSTGRES_PASSWORD=creativedeploy_dev_password
POSTGRES_DB=creativedeploy
POSTGRES_PORT=55432
# JSON list consumed by pydantic-settings. Wildcards are rejected.
TRUSTED_HOSTS=["localhost","127.0.0.1","testserver"]
